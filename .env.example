# PostgreSQL connection string (Render Postgres, Supabase, Neon, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/mikolo?schema=public"

# Secret used to sign JWTs — set a long random string in production
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port the API listens on (Render sets this automatically)
PORT=4000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN="http://localhost:3000"

# Public base URL of this API (used to build receipt/file links)
API_BASE_URL="http://localhost:4000"
